[Unit]
Description=Data Sync Web Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<USER>
WorkingDirectory=<PROJECT_DIR>
ExecStart=<PROJECT_DIR>/venv/bin/uvicorn web_server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
